	<Frame name="PrettyRepsReputationFrame" setAllPoints="true" enableMouse="true" parent="CharacterFrame" useParentLevel="true" mixin="PrettyRepsReputationFrameMixin" hidden="true" id="2">
		<Frames>
			<!-- First position the dropdown -->
			<DropdownButton parentKey="filterDropdown" inherits="WowStyle1DropdownTemplate">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-38" y="-30"/>
				</Anchors>
			</DropdownButton>

			<!-- Then position the search box relative to the dropdown -->
			<EditBox parentKey="searchBox" letters="40" autoFocus="false" inherits="InputBoxTemplate">
				<Size x="150" y="20"/>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.filterDropdown" relativePoint="LEFT" x="-10" y="0"/>
				</Anchors>
				<FontString inherits="GameFontHighlight"/>
				<Frames>
					<Button parentKey="ClearButton" hidden="true">
						<Size x="10" y="10"/>
						<Anchors>
							<Anchor point="RIGHT" x="-6" y="0"/>
						</Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<Texture parentKey="Icon" atlas="common-search-clearbutton">
									<Size x="10" y="10"/>
									<Anchors>
										<Anchor point="CENTER"/>
									</Anchors>
									<Color r="0.5" g="0.5" b="0.5"/>
								</Texture>
							</Layer>
						</Layers>
						<Scripts>
							<OnClick>
								local editBox = self:GetParent()
								editBox:SetText("Search...")
								editBox:SetTextColor(0.5, 0.5, 0.5)
								editBox:ClearFocus()
								self:Hide()
							</OnClick>
							<OnEnter>
								self.Icon:SetAtlas("common-search-clearbutton-highlight")
								self.Icon:SetVertexColor(0.7, 0.7, 0.7)
							</OnEnter>
							<OnLeave>
								self.Icon:SetAtlas("common-search-clearbutton")
								self.Icon:SetVertexColor(0.5, 0.5, 0.5)
							</OnLeave>
						</Scripts>
					</Button>
				</Frames>
				<Scripts>
					<OnLoad>
						self:SetTextInsets(8, 26, 0, 0)
						self:SetText("Search...")
						self:SetTextColor(0.5, 0.5, 0.5)
					</OnLoad>
					<OnEnter>
						if not self:HasFocus() then
							GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
							GameTooltip:SetText("Search by faction name or character name")
							GameTooltip:Show()
						end
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide()
					</OnLeave>
					<OnEditFocusGained>
						GameTooltip:Hide()
						if self:GetText() == "Search..." then
							self:SetText("")
							self:SetTextColor(1, 1, 1)
						end
						if self:GetText() ~= "" then
							self.ClearButton:Show()
						end
					</OnEditFocusGained>
					<OnEditFocusLost>
						if self:GetText() == "" then
							self:SetText("Search...")
							self:SetTextColor(0.5, 0.5, 0.5)
							self.ClearButton:Hide()
						end
					</OnEditFocusLost>
					<OnTextChanged>
						if self:GetText() == "Search..." then
							self:SetTextColor(0.5, 0.5, 0.5)
							self.ClearButton:Hide()
						else
							self:SetTextColor(1, 1, 1)
							self.ClearButton:SetShown(self:GetText() ~= "")
						end
						self:GetParent():UpdateSearchResults(self:GetText())
					</OnTextChanged>
					<OnEscapePressed>
						self:SetText("")
						self:ClearFocus()
						self.ClearButton:Hide()
					</OnEscapePressed>
					<OnEnterPressed>
						self:ClearFocus()
					</OnEnterPressed>
				</Scripts>
			</EditBox>

